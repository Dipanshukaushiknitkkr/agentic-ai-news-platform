{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "backend/**",
          "frontend/**",
          "data/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://agentic-ai-news-platform.onrender.com/api/$1"
    },
    {
      "src": "/auth/(.*)",
      "dest": "https://agentic-ai-news-platform.onrender.com/auth/$1"
    },
    {
      "src": "/ping",
      "dest": "https://agentic-ai-news-platform.onrender.com/ping"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
